                    "400": {
                        "description": "Campo inválido, ou documento que não corresponde ao tipo",
                        "content": {
                            "application/problem+json": {
                                "examples": {
                                    "Campos inválidos": {
                                        "description": "Campos inválidos",
                                        "value": {
                                            "type": "http://localhost:8080/problemas/dados-invalidos",
                                            "title": "Dados inválidos",
                                            "status": 400,
                                            "detail": "Um ou mais campos da requisição não passaram na validação.",
                                            "instance": "/api/v1/usuarios",
                                            "momento": "2026-10-08T10:30:00",
                                            "erros": [
                                                {
                                                    "campo": "email",
                                                    "mensagem": "O e-mail informado não é válido."
