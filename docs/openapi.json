        "/api/v2/usuarios": {
            "get": {
                "tags": [
                    "Usuários v2"
                ],
                "summary": "Busca usuários pelo nome, com paginação",
                "description": "Mesma busca da v1, com outra resposta: em vez da lista, um objeto com a lista em \"conteudo\" e os dados da página. Por isso é uma versão nova: quem consome a v1 não lê esta resposta. São 10 itens por página por padrão, no máximo 50, em ordem de nome. O sort aceita id, nome, email, login, dataCriacao e dataUltimaAlteracao.",
                "operationId": "buscarPorNome_1",
                "parameters": [
                    {
                        "name": "nome",
                        "in": "query",
                        "description": "Trecho do nome",
                        "required": false,
                        "schema": {
                            "type": "string"
                        },
                        "example": "maria"
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Número da página, a partir de 0",
                        "schema": {
                            "type": "integer",
                            "default": 0
                        }
                    },
                    {
                        "name": "size",
                        "in": "query",
                        "description": "Itens por página, no máximo 50",
                        "schema": {
                            "type": "integer",
                            "default": 10
                        }
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "description": "Campo e direção, como nome,desc",
                        "schema": {
                            "type": "string",
                            "default": "nome,asc"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Página de usuários",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PaginaResponse"
                                },
                                "example": {
                                    "conteudo": [
                                        {
                                            "id": 1,
                                            "nome": "Maria Silva",
                                            "email": "maria.silva@exemplo.com",
                                            "login": "maria.silva",
                                            "tipo": "CLIENTE",
                                            "documento": "12345678909",
                                            "endereco": {
                                                "rua": "Rua das Flores",
                                                "numero": "123",
                                                "complemento": "Apto 45",
                                                "bairro": "Centro",
                                                "cidade": "Itajaí",
                                                "estado": "SC",
                                                "cep": "88301000"
                                            },
                                            "dataCriacao": "2026-10-08T10:30:00",
                                            "dataUltimaAlteracao": "2026-10-08T10:30:00"
                                        }
                                    ],
                                    "pagina": 0,
                                    "tamanho": 10,
                                    "totalElementos": 1,
                                    "totalPaginas": 1,
                                    "ultima": true
                                }
                            }
                        }
                    },
                    "400": {
