{
    "openapi": "3.1.0",
    "info": {
        "title": "API de Gestão de Restaurantes",
        "description": "Sistema compartilhado de gestão para restaurantes - Fase 2.\n\nGerencia usuários e seus tipos, restaurantes com horários de funcionamento e os itens do cardápio de cada restaurante.\n\n**Versionamento:** a versão faz parte da rota (/api/v1/...). Mudanças compatíveis, como um campo novo na resposta, ficam na versão atual. Só uma mudança que quebra quem já consome a API gera versão nova, como /api/v2/usuarios, cuja busca por nome devolve uma página em vez de uma lista. Recursos novos nascem em v1.\n\n**Erros:** todas as respostas de erro seguem a RFC 9457 (ProblemDetail). O campo type aponta para /problemas/{identificador}, que descreve o problema.",
        "contact": {
            "name": "Thiago Wippel Chaves",
            "email": "thiagowippel@hotmail.com"
        },
        "license": {
            "name": "Uso acadêmico - FIAP Pós Tech"
        },
        "version": "v1"
    },
    "servers": [
        {
            "url": "http://localhost:8080",
            "description": "docker compose (APP_PORT padrão)"
        }
    ],
    "tags": [
        {
            "name": "Usuários v2",
            "description": "Busca de usuários com paginação"
        },
        {
            "name": "Usuários",
            "description": "Cadastro, consulta, atualização, troca de senha e exclusão de usuários"
        },
        {
            "name": "Autenticação",
            "description": "Validação de login e senha"
        }
    ],
    "paths": {
        "/api/v1/usuarios/{id}": {
            "get": {
                "tags": [
                    "Usuários"
                ],
                "summary": "Consulta um usuário pelo id",
                "operationId": "buscarPorId",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Id do usuário",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        },
                        "example": 1
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Usuário encontrado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UsuarioResponse"
                                },
                                "example": {
                                    "id": 1,
                                    "nome": "Maria Silva",
                                    "email": "maria.silva@exemplo.com",
                                    "login": "maria.silva",
                                    "tipo": "CLIENTE",
                                    "documento": "12345678909",
                                    "endereco": {
                                        "rua": "Rua das Flores",
                                        "numero": "123",
                                        "complemento": "Apto 45",
                                        "bairro": "Centro",
                                        "cidade": "Itajaí",
                                        "estado": "SC",
                                        "cep": "88301000"
                                    },
                                    "dataCriacao": "2026-10-08T10:30:00",
                                    "dataUltimaAlteracao": "2026-10-08T10:30:00"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Usuário inexistente ou removido",
                        "content": {
                            "application/problem+json": {
                                "example": {
                                    "type": "http://localhost:8080/problemas/recurso-nao-encontrado",
                                    "title": "Recurso não encontrado",
                                    "status": 404,
                                    "detail": "Usuário 99 não encontrado.",
                                    "instance": "/api/v1/usuarios/99",
                                    "momento": "2026-10-08T10:30:00"
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "tags": [
                    "Usuários"
                ],
                "summary": "Atualiza os dados de um usuário",
                "description": "Altera nome, e-mail, login e endereço. A senha e o tipo têm endpoints próprios.",
                "operationId": "atualizar",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Id do usuário",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        },
                        "example": 1
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/AtualizarUsuarioRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Usuário atualizado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UsuarioResponse"
                                },
                                "example": {
                                    "id": 1,
                                    "nome": "Maria Silva",
                                    "email": "maria.silva@exemplo.com",
                                    "login": "maria.silva",
                                    "tipo": "CLIENTE",
                                    "documento": "12345678909",
                                    "endereco": {
                                        "rua": "Rua das Flores",
                                        "numero": "123",
                                        "complemento": "Apto 45",
                                        "bairro": "Centro",
                                        "cidade": "Itajaí",
                                        "estado": "SC",
                                        "cep": "88301000"
                                    },
                                    "dataCriacao": "2026-10-08T10:30:00",
                                    "dataUltimaAlteracao": "2026-10-08T10:30:00"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Campo inválido",
                        "content": {
                            "application/problem+json": {
                                "example": {
                                    "type": "http://localhost:8080/problemas/dados-invalidos",
                                    "title": "Dados inválidos",
                                    "status": 400,
                                    "detail": "Um ou mais campos da requisição não passaram na validação.",
                                    "instance": "/api/v1/usuarios",
                                    "momento": "2026-10-08T10:30:00",
                                    "erros": [
                                        {
                                            "campo": "email",
                                            "mensagem": "O e-mail informado não é válido."
                                        },
                                        {
                                            "campo": "senha",
                                            "mensagem": "A senha deve ter entre 8 e 72 caracteres."
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Usuário inexistente ou removido",
                        "content": {
                            "application/problem+json": {
                                "example": {
                                    "type": "http://localhost:8080/problemas/recurso-nao-encontrado",
                                    "title": "Recurso não encontrado",
                                    "status": 404,
                                    "detail": "Usuário 99 não encontrado.",
                                    "instance": "/api/v1/usuarios/99",
                                    "momento": "2026-10-08T10:30:00"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "E-mail ou login de outro usuário",
                        "content": {
                            "application/problem+json": {
                                "example": {
                                    "type": "http://localhost:8080/problemas/conflito-de-dados",
                                    "title": "Conflito de dados",
                                    "status": 409,
                                    "detail": "O e-mail informado já está cadastrado.",
                                    "instance": "/api/v1/usuarios",
                                    "momento": "2026-10-08T10:30:00"
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "Usuários"
                ],
                "summary": "Exclui um usuário",
                "description": "Anonimiza o registro: o nome vira \"Usuário removido\" e os dados pessoais são apagados. Depois disso o usuário não aparece nas buscas, não faz login, e o e-mail, o login e o documento ficam livres para um novo cadastro.",
                "operationId": "excluir",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Id do usuário",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        },
                        "example": 1
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Usuário excluído"
                    },
                    "404": {
                        "description": "Usuário inexistente ou já removido",
                        "content": {
                            "application/problem+json": {
                                "example": {
                                    "type": "http://localhost:8080/problemas/recurso-nao-encontrado",
                                    "title": "Recurso não encontrado",
                                    "status": 404,
                                    "detail": "Usuário 99 não encontrado.",
                                    "instance": "/api/v1/usuarios/99",
                                    "momento": "2026-10-08T10:30:00"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/usuarios/{id}/senha": {
            "put": {
                "tags": [
                    "Usuários"
