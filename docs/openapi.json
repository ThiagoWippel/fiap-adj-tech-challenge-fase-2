                                    "status": 400,
                                    "detail": "Um ou mais campos da requisição não passaram na validação.",
                                    "instance": "/api/v1/usuarios",
                                    "momento": "2026-10-08T10:30:00",
                                    "erros": [
                                        {
                                            "campo": "email",
                                            "mensagem": "O e-mail informado não é válido."
                                        },
                                        {
                                            "campo": "senha",
                                            "mensagem": "A senha deve ter entre 8 e 72 caracteres."
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Senha atual incorreta",
                        "content": {
                            "application/problem+json": {
                                "example": {
                                    "type": "http://localhost:8080/problemas/credenciais-invalidas",
                                    "title": "Credenciais inválidas",
                                    "status": 401,
                                    "detail": "A senha atual informada está incorreta.",
                                    "instance": "/api/v1/usuarios/1/senha",
                                    "momento": "2026-10-08T10:30:00"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Usuário inexistente ou removido",
                        "content": {
                            "application/problem+json": {
                                "example": {
                                    "type": "http://localhost:8080/problemas/recurso-nao-encontrado",
                                    "title": "Recurso não encontrado",
                                    "status": 404,
                                    "detail": "Usuário 99 não encontrado.",
                                    "instance": "/api/v1/usuarios/99",
                                    "momento": "2026-10-08T10:30:00"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/usuarios": {
            "get": {
                "tags": [
                    "Usuários"
                ],
                "summary": "Busca usuários pelo nome",
                "description": "Devolve os usuários cujo nome contém o termo, sem diferenciar maiúsculas nem acentos, em ordem alfabética. Sem o termo, devolve todos. Nenhum resultado é uma lista vazia, não um 404. A versão paginada fica em /api/v2/usuarios.",
                "operationId": "buscarPorNome",
                "parameters": [
                    {
                        "name": "nome",
                        "in": "query",
                        "description": "Trecho do nome",
                        "required": false,
                        "schema": {
                            "type": "string"
                        },
                        "example": "maria"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lista de usuários, possivelmente vazia",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/UsuarioResponse"
                                    }
                                },
                                "example": [
                                    {
                                        "id": 1,
                                        "nome": "Maria Silva",
                                        "email": "maria.silva@exemplo.com",
                                        "login": "maria.silva",
                                        "tipo": "CLIENTE",
                                        "documento": "12345678909",
                                        "endereco": {
                                            "rua": "Rua das Flores",
                                            "numero": "123",
                                            "complemento": "Apto 45",
                                            "bairro": "Centro",
                                            "cidade": "Itajaí",
                                            "estado": "SC",
                                            "cep": "88301000"
                                        },
                                        "dataCriacao": "2026-10-08T10:30:00",
                                        "dataUltimaAlteracao": "2026-10-08T10:30:00"
                                    }
                                ]
                            }
                        }
                    },
                    "400": {
                        "description": "Parâmetro em formato inválido",
                        "content": {
                            "application/problem+json": {
                                "example": {
                                    "type": "http://localhost:8080/problemas/dados-invalidos",
                                    "title": "Dados inválidos",
                                    "status": 400,
                                    "detail": "Um ou mais campos da requisição não passaram na validação.",
                                    "instance": "/api/v1/usuarios",
                                    "momento": "2026-10-08T10:30:00",
                                    "erros": [
                                        {
                                            "campo": "email",
                                            "mensagem": "O e-mail informado não é válido."
                                        },
                                        {
                                            "campo": "senha",
                                            "mensagem": "A senha deve ter entre 8 e 72 caracteres."
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Usuários"
                ],
                "summary": "Cadastra um usuário",
                "description": "O tipo é o código de um tipo de usuário, como CLIENTE ou DONO_RESTAURANTE. Dono de restaurante informa CNPJ; os demais tipos informam CPF. Os documentos são aceitos com ou sem pontuação e gravados só com dígitos. E-mail, login e documento são únicos.",
                "operationId": "cadastrar",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CriarUsuarioRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Usuário cadastrado. O cabeçalho Location aponta para ele.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UsuarioResponse"
                                },
                                "example": {
                                    "id": 1,
                                    "nome": "Maria Silva",
                                    "email": "maria.silva@exemplo.com",
                                    "login": "maria.silva",
                                    "tipo": "CLIENTE",
                                    "documento": "12345678909",
                                    "endereco": {
                                        "rua": "Rua das Flores",
                                        "numero": "123",
                                        "complemento": "Apto 45",
                                        "bairro": "Centro",
                                        "cidade": "Itajaí",
                                        "estado": "SC",
                                        "cep": "88301000"
                                    },
                                    "dataCriacao": "2026-10-08T10:30:00",
