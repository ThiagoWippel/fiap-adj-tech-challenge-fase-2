# Modelo de variáveis de ambiente
# Copie para .env e substitua os valores: cp .env.example .env
# O .env contém credenciais reais e NÃO deve ser versionado.

DB_NAME=restaurante_db
DB_USER=restaurante
DB_PASSWORD=altere_esta_senha
DB_ROOT_PASSWORD=altere_esta_senha_root
DB_EXTERNAL_PORT=3307
APP_PORT=8080
