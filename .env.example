# Copie para .env (cp .env.example .env) e ajuste os valores.
# O .env fica fora do git.

DB_NAME=restaurante_db
DB_USER=restaurante
DB_PASSWORD=altere_esta_senha
DB_ROOT_PASSWORD=altere_esta_senha_root
DB_EXTERNAL_PORT=3307
APP_PORT=8080

# Chave de assinatura do token do login, com ao menos 32 caracteres.
# Para gerar uma: openssl rand -base64 32
JWT_CHAVE=troque-esta-chave-por-um-valor-aleatorio-de-32-ou-mais
