# Configuração do Lombok para todo o projeto.
config.stopBubbling = true

# Marca o código gerado (getters, equals, hashCode) com @Generated.
# O JaCoCo ignora métodos com essa marcação; sem ela, cada equals
# gerado contaria como dezenas de ramos sem teste e distorceria o
# corte de cobertura de ramos.
lombok.addLombokGeneratedAnnotation = true
